# Copy to a secret-managed location outside the repository and replace every placeholder.
# API/frontend references below are the verified SHA256 OCI index digests from release workflow run 37201620316.
ITOPS_API_IMAGE=ghcr.io/paswannishant7-spec/itops-control-center-api@sha256:82c6eac2dcdf28b5f7aaab65f332e5bcae16010eb8771ec92491538bd0ec5f3f
ITOPS_FRONTEND_IMAGE=ghcr.io/paswannishant7-spec/itops-control-center-frontend@sha256:923c6bd4ad8f1fb09630a7f8e35dd73cd3891a3e5edd653f4aa2827482b51771
ITOPS_CLAMAV_IMAGE=clamav/clamav:1.5.4-debian13-slim
ITOPS_TLS_IMAGE=caddy:2.11.6-alpine
ITOPS_DEMO_HOST=support.example.com

POSTGRES_DB=itops
POSTGRES_USER=itops
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
# URL-encode reserved characters in the password below.
ITOPS_DATABASE_URL=postgresql+psycopg://itops:replace-with-url-encoded-password@database:5432/itops

ITOPS_CORS_ORIGINS=["https://support.example.com"]
ITOPS_JWT_SECRET=replace-with-at-least-32-random-characters
ITOPS_LOG_LEVEL=INFO
ITOPS_ATTACHMENT_CLAMAV_HOST=clamav
ITOPS_ATTACHMENT_CLAMAV_PORT=3310

# Use only during first bootstrap, then remove all three values.
ITOPS_INITIAL_ADMIN_EMAIL=
ITOPS_INITIAL_ADMIN_NAME=Platform Administrator
ITOPS_INITIAL_ADMIN_PASSWORD=

ITOPS_AI_PROVIDER=disabled
ITOPS_OPENAI_API_KEY=
