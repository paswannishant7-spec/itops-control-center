# Copy to a secret-managed location outside the repository and replace every placeholder.
ITOPS_API_IMAGE=ghcr.io/example/itops-control-center-api:v1.0.0
ITOPS_FRONTEND_IMAGE=ghcr.io/example/itops-control-center-frontend:v1.0.0
ITOPS_HTTP_BIND=127.0.0.1
ITOPS_HTTP_PORT=8080

POSTGRES_DB=itops
POSTGRES_USER=itops
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
# URL-encode reserved characters in the password below.
ITOPS_DATABASE_URL=postgresql+psycopg://itops:replace-with-url-encoded-password@database:5432/itops

ITOPS_CORS_ORIGINS=["https://support.example.com"]
ITOPS_JWT_SECRET=replace-with-at-least-32-random-characters
ITOPS_LOG_LEVEL=INFO
ITOPS_ATTACHMENT_CLAMAV_HOST=clamav.internal
ITOPS_ATTACHMENT_CLAMAV_PORT=3310

# Use only during first bootstrap, then remove all three values.
ITOPS_INITIAL_ADMIN_EMAIL=
ITOPS_INITIAL_ADMIN_NAME=Platform Administrator
ITOPS_INITIAL_ADMIN_PASSWORD=

ITOPS_AI_PROVIDER=disabled
ITOPS_OPENAI_API_KEY=
