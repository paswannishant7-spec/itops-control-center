ITOPS_ENVIRONMENT=development
ITOPS_LOG_LEVEL=INFO
ITOPS_LOG_JSON=false
ITOPS_CORS_ORIGINS=["http://localhost:5173"]
ITOPS_DATABASE_URL=postgresql+psycopg://itops:replace-with-a-local-only-password@localhost:5432/itops
ITOPS_DATABASE_POOL_SIZE=10
ITOPS_DATABASE_MAX_OVERFLOW=20
ITOPS_DATABASE_POOL_TIMEOUT_SECONDS=10
ITOPS_DATABASE_CONNECT_TIMEOUT_SECONDS=5
ITOPS_JWT_SECRET=replace-with-at-least-32-random-characters
ITOPS_JWT_ISSUER=itops-control-center
ITOPS_JWT_AUDIENCE=itops-control-center-api
ITOPS_ACCESS_TOKEN_MINUTES=10
ITOPS_REFRESH_TOKEN_DAYS=7
ITOPS_SECURE_COOKIES=false
ITOPS_LOGIN_RATE_LIMIT_ATTEMPTS=5
ITOPS_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
ITOPS_REFRESH_RATE_LIMIT_ATTEMPTS=20
ITOPS_REFRESH_RATE_LIMIT_WINDOW_SECONDS=60
ITOPS_INITIAL_ADMIN_EMAIL=nishant.paswan@example.com
ITOPS_INITIAL_ADMIN_NAME=Nishant Paswan
ITOPS_INITIAL_ADMIN_PASSWORD=replace-with-a-strong-demo-password
# Optional development/test-only enterprise dataset. Use a local secret; never commit it.
ITOPS_ENTERPRISE_SEED_PASSWORD=
ITOPS_ATTACHMENT_STORAGE_PATH=.data/attachments
ITOPS_ATTACHMENT_MAX_BYTES=10485760
# Set a private ClamAV endpoint and require scans in production.
ITOPS_ATTACHMENT_CLAMAV_HOST=
ITOPS_ATTACHMENT_CLAMAV_PORT=3310
ITOPS_ATTACHMENT_SCAN_TIMEOUT_SECONDS=5
ITOPS_ATTACHMENT_SCAN_REQUIRED=false
ITOPS_SLA_WORKER_INTERVAL_SECONDS=60
ITOPS_SLA_WORKER_BATCH_SIZE=100
ITOPS_AI_PROVIDER=disabled
ITOPS_AI_MODEL=gpt-5.6-luna
ITOPS_AI_EMBEDDING_MODEL=text-embedding-3-small
ITOPS_AI_EMBEDDING_DIMENSIONS=1536
ITOPS_AI_PROVIDER_TIMEOUT_SECONDS=20
ITOPS_AI_MAX_INPUT_CHARACTERS=6000
ITOPS_AI_MODERATE_CONFIDENCE_THRESHOLD=0.70
ITOPS_AI_HIGH_CONFIDENCE_THRESHOLD=0.90
ITOPS_RAG_CHUNK_CHARACTERS=1200
ITOPS_RAG_CHUNK_OVERLAP_CHARACTERS=150
ITOPS_RAG_TOP_K=5
ITOPS_RAG_MIN_SIMILARITY=0.25
ITOPS_SIMILAR_TICKET_CANDIDATE_POOL=100
ITOPS_SIMILAR_TICKET_TOP_K=5
ITOPS_SIMILAR_TICKET_MIN_SIMILARITY=0.60
ITOPS_MONITORING_EXPECTED_HEARTBEAT_SECONDS=60
ITOPS_MONITORING_HEARTBEAT_TIMEOUT_SECONDS=180
ITOPS_MONITORING_METRIC_MIN_INTERVAL_SECONDS=30
ITOPS_MONITORING_RETENTION_DAYS=30
ITOPS_MONITORING_WORKER_INTERVAL_SECONDS=60
ITOPS_REALTIME_AUTH_TIMEOUT_SECONDS=5
ITOPS_REALTIME_POLL_INTERVAL_SECONDS=1
ITOPS_REALTIME_HEARTBEAT_SECONDS=20
ITOPS_REALTIME_BATCH_SIZE=100
ITOPS_REALTIME_RETENTION_HOURS=24
# Required only when ITOPS_AI_PROVIDER=openai. Never commit a real key.
ITOPS_OPENAI_API_KEY=
